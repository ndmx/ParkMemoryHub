<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Bundle Identifier -->
    <key>CFBundleIdentifier</key>
    <string>lxr.ParkMemoryHub</string>
    
    <!-- Bundle Name -->
    <key>CFBundleName</key>
    <string>ParkMemory Hub</string>
    
    <!-- Bundle Display Name -->
    <key>CFBundleDisplayName</key>
    <string>ParkMemory Hub</string>
    
    <!-- Bundle Version -->
    <key>CFBundleVersion</key>
    <string>$(CURRENT_PROJECT_VERSION)</string>
    
    <!-- Bundle Short Version -->
    <key>CFBundleShortVersionString</key>
    <string>$(MARKETING_VERSION)</string>
    
    <!-- Bundle Package Type -->
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    
    <!-- Bundle Executable -->
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>

    <!-- Export Compliance -->
    <key>ITSAppUsesNonExemptEncryption</key>
    <false/>

    <!-- App Link Scheme -->
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key>
            <string>lxr.ParkMemoryHub</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>parkmemoryhub</string>
            </array>
        </dict>
    </array>
    
    <!-- Bundle Info Dictionary Version -->
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    
    <!-- Location Usage Descriptions -->
    <key>NSLocationWhenInUseUsageDescription</key>
	<string>ParkMemory Hub uses your location to tag memories and help your group find each other during a park visit.</string>
    
    <!-- Photo Library Usage Description -->
    <key>NSPhotoLibraryUsageDescription</key>
    <string>ParkMemory Hub needs access to your photo library to save and share your park memories.</string>
    
    <!-- Supported Interface Orientations -->
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationPortraitUpsideDown</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>

    <!-- Launch Screen -->
    <key>UILaunchScreen</key>
    <dict>
        <key>UIColorName</key>
        <string>AccentColor</string>
        <key>UIImageName</key>
        <string></string>
    </dict>

    <!-- Application requires full screen -->
    <key>UIRequiresFullScreen</key>
    <false/>
    
    <!-- Status Bar Style -->
    <key>UIStatusBarStyle</key>
    <string>UIStatusBarStyleDefault</string>
    
    <!-- View Controller Based Status Bar Appearance -->
    <key>UIViewControllerBasedStatusBarAppearance</key>
    <true/>
</dict>
</plist>
